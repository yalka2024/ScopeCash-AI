# ─── Server runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Auth & sessions ───────────────────────────────────────────
# REQUIRED: 32+ char random string. Server refuses to start with placeholder.
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_FAILED=8
LOGIN_LOCK_MINUTES=15

# ─── Encryption (field-level encryption + searchable hashing) ──
# REQUIRED in production: two distinct 32-byte base64 keys. The server refuses
# to start in production without them.
#   Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
ENCRYPTION_SEARCH_KEY=

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed dashboard origins.
CORS_ORIGIN=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────
# DEV (SQLite, default — uses @prisma/adapter-better-sqlite3):
DATABASE_URL=file:./dev.db

# PROD (Postgres — uses @prisma/adapter-pg):
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME?schema=public&sslmode=require
# When DATABASE_URL points at a pooled connection (PgBouncer / Supabase pooler /
# Neon pooler), set DIRECT_URL to the unpooled connection — Prisma migrations
# require a direct connection.
# DIRECT_URL=postgresql://USER:PASS@HOST:5432/DBNAME?schema=public&sslmode=require

# ─── Redis (rate limiting + queues; optional in dev) ───────────
# REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4
CACHE_DEFAULT_TTL=60
SHUTDOWN_TIMEOUT_MS=25000
SHUTDOWN_HARD_TIMEOUT_MS=40000

# ─── Object storage ────────────────────────────────────────────
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=20971520

# ─── Antivirus scanning (optional; fail-open by default) ───────
# AV_SCAN_URL=http://localhost:3310/scan
# AV_FAIL_OPEN=1

# ─── Vertex AI (evidence pipeline — server/lib/vertex-ai.js) ───
# Auth is Application Default Credentials, not an API key:
#   - Cloud Run/GCE/GKE: workload identity, no env needed.
#   - Local dev: `gcloud auth application-default login`, or set
#     GOOGLE_APPLICATION_CREDENTIALS to a service account key file.
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# Pin a SPECIFIC, dated/numbered model id — never a "-latest" alias (Google
# retires dated Gemini versions; every AgentRunRecord/Citation must be able
# to point at exactly which version produced it). Find current ids at
# https://cloud.google.com/vertex-ai/generative-ai/docs/models
# VERTEX_GEMINI_MODEL=gemini-2.5-flash-001
# VERTEX_GEMINI_PRO_MODEL=gemini-2.5-pro-001

# ─── AI provider ───────────────────────────────────────────────
# AI_PROVIDER=openai            # openai | anthropic | gemini | ollama
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Google Gemini (key from Google AI Studio / Vertex AI):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Resilience: behavior flows retry once on a transient error (429/5xx/timeout)
# then fail over to this provider — keeps the customer flow up through a
# primary rate-limit/capacity blip (e.g. free-tier Gemini). Needs its own key.
# FALLBACK_AI_PROVIDER=anthropic
# Local / on-prem inference via Ollama (no API key, runs in your network):
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_INPUT_CHARS=8000
# Guided-flow leads: email the owner when a behavior session completes (a lead
# is captured or an emergency escalates). Unset = persist only, no email.
# BEHAVIOR_NOTIFY_EMAIL=owner@example.com

# ─── Knowledge base / RAG (when knowledge_base is enabled) ──────
# EMBEDDING_PROVIDER falls back to a local hash embedding when unset/openai key
# is missing, so RAG works offline. Set to 'openai' for real embeddings.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

# ─── Stripe billing (optional in dev) ──────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=

# ─── Email (optional in dev) ───────────────────────────────────
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM=no-reply@example.com

# ─── Observability (optional) ──────────────────────────────────
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

