# ─── Server runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Node's libuv threadpool (default 4) is what @node-rs/bcrypt's async
# hash/compare runs on -- found via load testing (see TODO.md "Perf/load/
# soak testing") that under sustained concurrent login traffic, 4 slots
# becomes the throughput ceiling (queued, not blocking the main event
# loop the way the old bcryptjs implementation did). Must be set before
# Node starts; raising it is a real lever for deployments expecting login
# bursts.
# UV_THREADPOOL_SIZE=16

# ─── Auth & sessions ───────────────────────────────────────────
# REQUIRED: 32+ char random string. Server refuses to start with placeholder.
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_FAILED=8
LOGIN_LOCK_MINUTES=15

# ─── Encryption (field-level encryption + searchable hashing) ──
# REQUIRED in production: two distinct 32-byte base64 keys. The server refuses
# to start in production without them.
#   Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
ENCRYPTION_SEARCH_KEY=

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed dashboard origins.
CORS_ORIGIN=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────
# DEV (SQLite, default — uses @prisma/adapter-better-sqlite3):
DATABASE_URL=file:./dev.db

# PROD (Postgres — uses @prisma/adapter-pg):
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME?schema=public&sslmode=require
# When DATABASE_URL points at a pooled connection (PgBouncer / Supabase pooler /
# Neon pooler), set DIRECT_URL to the unpooled connection — Prisma migrations
# require a direct connection.
# DIRECT_URL=postgresql://USER:PASS@HOST:5432/DBNAME?schema=public&sslmode=require

# ─── Redis (rate limiting + queues; optional in dev) ───────────
# REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4
CACHE_DEFAULT_TTL=60
SHUTDOWN_TIMEOUT_MS=25000
SHUTDOWN_HARD_TIMEOUT_MS=40000

# ─── Object storage ────────────────────────────────────────────
# STORAGE_DRIVER: local | s3 | gcs
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# gcs driver reuses GCP_PROJECT_ID (below) + STORAGE_BUCKET; auth is ADC,
# same as Vertex AI — no separate key handling.
UPLOAD_MAX_BYTES=20971520

# ─── Cloud Tasks (durable job queue — server/lib/cloud-tasks.js) ─
# Set JOBS_BACKEND=cloud-tasks to enqueue through GCP instead of BullMQ/local.
# JOBS_BACKEND=cloud-tasks
# GCP_TASKS_LOCATION=us-central1
# CLOUD_TASKS_QUEUE=scopecash-jobs
# CLOUD_TASKS_INVOKER_SA=scopecash-tasks-invoker@PROJECT_ID.iam.gserviceaccount.com
# CLOUD_TASKS_PUSH_URL=https://YOUR-DEPLOYED-URL/api/jobs/process-task
# CLOUD_TASKS_PUSH_AUDIENCE=https://YOUR-DEPLOYED-URL/api/jobs/process-task

# ─── Secret Manager (server/lib/secret-manager.js) ──────────────
# Reuses GCP_PROJECT_ID (above, Vertex AI section). No further config needed.
# SECRET_CACHE_TTL_MS=300000

# ─── Antivirus scanning (optional; fail-open by default) ───────
# AV_SCAN_URL=http://localhost:3310/scan
# AV_FAIL_OPEN=1

# ─── Vertex AI (evidence pipeline — server/lib/vertex-ai.js) ───
# Auth is Application Default Credentials, not an API key:
#   - Cloud Run/GCE/GKE: workload identity, no env needed.
#   - Local dev: `gcloud auth application-default login`, or set
#     GOOGLE_APPLICATION_CREDENTIALS to a service account key file.
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# Pin a SPECIFIC, dated/numbered model id — never a "-latest" alias (Google
# retires dated Gemini versions; every AgentRunRecord/Citation must be able
# to point at exactly which version produced it). Find current ids at
# https://cloud.google.com/vertex-ai/generative-ai/docs/models
# VERTEX_GEMINI_MODEL=gemini-2.5-flash-001
# VERTEX_GEMINI_PRO_MODEL=gemini-2.5-pro-001

# ─── AI provider ───────────────────────────────────────────────
# AI_PROVIDER=openai            # openai | anthropic | gemini | ollama
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Google Gemini (key from Google AI Studio / Vertex AI):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Resilience: behavior flows retry once on a transient error (429/5xx/timeout)
# then fail over to this provider — keeps the customer flow up through a
# primary rate-limit/capacity blip (e.g. free-tier Gemini). Needs its own key.
# FALLBACK_AI_PROVIDER is NOT implemented — no code reads it. Removed rather
# than left documented; there is no AI provider failover today.
# Local / on-prem inference via Ollama (no API key, runs in your network):
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_INPUT_CHARS=8000
# Guided-flow leads: email the owner when a behavior session completes (a lead
# is captured or an emergency escalates). Unset = persist only, no email.
# BEHAVIOR_NOTIFY_EMAIL is NOT implemented — no code reads it.

# ─── Knowledge base / RAG (when knowledge_base is enabled) ──────
# EMBEDDING_PROVIDER falls back to a local hash embedding when unset/openai key
# is missing, so RAG works offline. Set to 'openai' for real embeddings.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

# ─── Stripe billing (optional in dev) ──────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=

# ─── Email (optional in dev) ───────────────────────────────────
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM=no-reply@example.com

# ─── Observability (optional) ──────────────────────────────────
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318


# ── Feature enablement flags ────────────────────────────────────────────────
# These gate REAL behaviour and default to off/mock. A 2026-07-28 sweep found
# none of them documented in any deploy artifact, so an operator following the
# docs would never discover them and the features would appear silently broken
# rather than deliberately disabled.

# Public base URL for customer-facing links. REQUIRED in any real deployment:
# routes/billing.js falls back to 'http://localhost:3000' for Stripe Checkout
# success/cancel and the customer-portal return, so a paying customer is
# redirected to localhost after paying. lib/email.js builds every transactional
# link from it too.
# PUBLIC_DASHBOARD_URL=https://app.example.com
# Used by routes/organization.js for the ownership-transfer acceptance link.
# Unset, the email contains a bare relative path that no mail client can open.
# APP_URL=https://app.example.com

# Pinned, dated Vertex model ids. REQUIRED for any AI feature: lib/vertex-ai.js
# throws `vertex_model_unpinned` without them and rejects "-latest" aliases.
# VERTEX_GEMINI_MODEL=gemini-2.5-flash-002
# VERTEX_GEMINI_PRO_MODEL=gemini-2.5-pro-002

# Durable background jobs. Without BOTH of these, lib/evidence-jobs.js falls
# back to in-process setImmediate and a job in flight is LOST on any restart —
# which on Cloud Run happens routinely at scale-to-zero.
# JOBS_BACKEND=cloud-tasks
# CLOUD_TASKS_PUSH_URL=https://app.example.com/api/jobs/process-task

# Integration adapters (lib/tools/*) default to MOCK and return
# {_mock: true} rather than doing anything real. Each needs its own switch;
# agents in lib/agent-runtime.js get the whole registry, so leaving these unset
# means agent tool calls silently return fabricated data.
# INTEGRATION_EMAILNOTIFICATIONSENDER_MODE=live
# INTEGRATION_STRIPECLIENT_MODE=live
# INTEGRATION_CLOUDSTORAGECLIENT_MODE=live
# INTEGRATION_SECRETMANAGERCLIENT_MODE=live
# INTEGRATION_MALWARESCANHOOK_MODE=live
# INTEGRATION_TOTPMFAPROVIDER_MODE=live
# INTEGRATION_AUDITLOGWRITER_MODE=live
# INTEGRATION_CLOUDTASKSENQUEUER_MODE=live
# INTEGRATION_SHA256HASHER_MODE=live
# INTEGRATION_OPENAPISPECEXPORTER_MODE=live

# GDPR erasure sweep — genuinely destructive, off by default on purpose.
# ORG_DELETION_SWEEP_ENABLED=1
# ORG_DELETION_SWEEP_DRY_RUN=1
# ORG_DELETION_GRACE_DAYS=30

# Data-retention enforcement — irreversibly deletes evidence past the plan's
# window. Report-only until this is set. See jobs/usage-aggregator.js.
# DATA_RETENTION_ENFORCE=1

# ── Data residency ──────────────────────────────────────────────────────────
# Published on the PUBLIC trust endpoint (lib/trust-pack.js) and enforced at
# boot (lib/data-residency.js): if this disagrees with GCP_LOCATION or the
# Cloud SQL instance region, the server refuses to start in production rather
# than publish a compliance claim its own infrastructure contradicts.
# Leaving it unset means trust-pack reports the literal default "US" while the
# boot check has nothing to validate against — set it explicitly in any real
# deployment.
# DATA_RESIDENCY_REGION=us-central1

# ── Cloud SQL IAM database authentication (GCP only) ────────────────────────
# Authenticates to Cloud SQL using the runtime's own IAM identity (short-lived
# OAuth + mTLS) instead of the static password in DATABASE_URL. Awaited by both
# index.js and worker.js before either accepts work. FAILS CLOSED: if enabled
# and misconfigured the process exits rather than silently falling back to
# password auth.
# Requires Terraform's var.cloud_sql_iam_auth = true, which provisions the
# CLOUD_IAM_SERVICE_ACCOUNT sql user and the instanceUser role binding.
# CLOUD_SQL_IAM_AUTH=1
# "project:region:instance". CLOUD_SQL_CONNECTION_NAME is accepted as an alias
# (that is the name the Terraform module exports).
# CLOUD_SQL_INSTANCE=my-project:us-central1:my-instance
# Service-account email WITHOUT the ".gserviceaccount.com" suffix — Cloud SQL's
# own convention for IAM DB usernames.
# CLOUD_SQL_IAM_USER=my-sa@my-project.iam
# Defaults to "scopecash_ai" (what Terraform creates) when unset.
# CLOUD_SQL_DATABASE=scopecash_ai

# ── Outcome (metered) billing ───────────────────────────────────────────────
# One env var per billable event, mapping it to a Stripe METER's event_name.
# Create the meter in Stripe first (Billing > Meters), then set the matching
# var here. The name is derived from the event: `success_fee_collected` ->
# STRIPE_METER_SUCCESS_FEE_COLLECTED.
#
# Without these, recordOutcome() records the outcome locally and reports
# `billed: false` with reason `no_meter_configured` — it does NOT silently
# claim to have charged. (It used to: the previous implementation called
# subscriptionItems.createUsageRecord, removed in Stripe SDK v22, and returned
# billed:true regardless, so every metered charge failed invisibly.)
# STRIPE_METER_SUCCESS_FEE_COLLECTED=success_fee_collected
