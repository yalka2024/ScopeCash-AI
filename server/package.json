{
  "name": "scopecash-ai-server",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "worker": "node worker.js",
    "worker:dev": "node --watch worker.js",
    "postinstall": "prisma generate",
    "db:setup": "prisma migrate deploy && node prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "node prisma/seed-riverside-demo.js",
    "db:postgres:sync": "node prisma/sync-postgres-schema.js",
    "db:postgres:check": "node prisma/sync-postgres-schema.js --check",
    "db:check:migrations": "node prisma/check-migration-parity.js",
    "db:postgres:generate": "npm run db:postgres:sync && prisma generate --config prisma.postgres.config.ts",
    "db:postgres:migrate:dev": "npm run db:postgres:sync && prisma migrate dev --config prisma.postgres.config.ts",
    "db:postgres:deploy": "npm run db:postgres:sync && prisma migrate deploy --config prisma.postgres.config.ts && npm run db:postgres:rls && node prisma/seed.js",
    "db:postgres:rls": "node prisma/apply-rls.js",
    "db:postgres:rag": "node prisma/apply-rag.js",
    "db:postgres:setup": "npm run db:postgres:deploy && node prisma/seed.js",
    "db:backup": "node scripts/db-backup.js",
    "db:backup:list": "node scripts/db-backup.js --list",
    "db:backup:prune": "node scripts/db-backup.js --prune-only",
    "db:restore": "node scripts/db-restore.js",
    "stripe:setup": "node scripts/stripe-setup.js",
    "stripe:setup:dry": "node scripts/stripe-setup.js --dry-run",
    "email:test": "node -e \"require('./lib/email').sendTemplate('test', process.env.EMAIL_TO || 'test@example.com', { sent_at: new Date().toISOString() }).then(r => console.log(JSON.stringify(r))).catch(e => { console.error(e); process.exit(1); })\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:postgres-rls": "jest --config jest.postgres.config.js --runInBand",
    "eval": "node scripts/eval-gate.js",
    "perf:load": "node scripts/loadtest.js",
    "perf:soak": "node scripts/loadtest.js --soak",
    "dr:drain-drill": "node scripts/dr-drain-drill.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@google-cloud/cloud-sql-connector": "^1.10.0",
    "@google-cloud/secret-manager": "^6.3.0",
    "@google-cloud/storage": "^7.21.0",
    "@google-cloud/tasks": "^6.2.3",
    "@google/genai": "^2.13.0",
    "@node-rs/bcrypt": "^1.10.7",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^8.40.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "bullmq": "^5.34.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.9.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "openai": "^6.34.0",
    "papaparse": "^5.5.4",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "resend": "^4.0.1",
    "stripe": "^22.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "pidusage": "^4.0.1",
    "supertest": "^7.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
