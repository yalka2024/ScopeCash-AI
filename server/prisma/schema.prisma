generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Core Auth & Organization ─────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String?
  role            String   @default("user")
  orgId           String?
  org             Organization? @relation(fields: [orgId], references: [id])
  emailVerified   Boolean  @default(false)
  mfaEnabled      Boolean  @default(false)
  mfaSecret       String?  // app-layer AES-256-GCM envelope (lib/encryption.js) — never plaintext at rest
  failedLogins    Int      @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  passwordChangedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  records         Project[]
  notifications   Notification[]
  apiKeys         ApiKey[]
  activities      Activity[]
  refreshTokens   RefreshToken[]
  emailTokens     EmailVerificationToken[]
  pwResetTokens   PasswordResetToken[]
  consents        Consent[]
  onboarding      OnboardingState?
  orgMemberships  OrgMembership[]

  @@index([orgId])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  plan        String   @default("free")
  createdAt   DateTime @default(now())
  users       User[]
  memberships OrgMembership[]
  invitations Invitation[]
}

// ─── Core Domain: Project ─────────────────

model Project {
  id              String   @id @default(uuid())
  projectName   String
  projectPath   String?
  storageKey      String?
  storageProvider String?
  contentType     String?
  fileSize        Int?
  status          String   @default("pending")
  riskScore       Int?
  overallRisk     String?
  reportJson      String?
  conformityJson  String?   // EU AI Act Article 43 self-assessment state
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  orgId           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([status])
}

// ─── Notifications ────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ─── API Keys ─────────────────────────────────────────

model ApiKey {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  keyHash     String   @unique
  prefix      String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  scopes      String   @default("read")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ─── Activity Log (append-only audit trail) ───────────

model Activity {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  orgId      String?
  action     String
  resource   String?
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  outcome    String   @default("success")
  createdAt  DateTime @default(now())

  // Tamper-evident hash chain (OBS-005). prevHash is unique so racing writers
  // collide on the unique constraint and retry rather than forking the chain.
  prevHash   String?  @unique
  hash       String?

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([action])
}

// ─── Webhooks ─────────────────────────────────────────

model Webhook {
  id           String   @id @default(uuid())
  userId       String
  url          String
  events       String
  secret       String
  active       Boolean  @default(true)
  failureCount Int      @default(0)
  disabledAt   DateTime?
  createdAt    DateTime @default(now())

  deliveries   WebhookDelivery[]
}

model WebhookDelivery {
  id            String   @id @default(uuid())
  webhookId     String
  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       String
  status        String   @default("pending") // pending|delivered|failed|dead
  attemptCount  Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

// ─── Refresh tokens & revocation ──────────────────────

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  family      String   // rotation family id; reuse of a revoked one in family => force-logout
  revokedAt   DateTime?
  replacedBy  String?
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([family])
}

// ─── Email verification & password reset ──────────────

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ─── AI usage / quotas ────────────────────────────────

model AiUsage {
  id          String   @id @default(uuid())
  userId      String
  orgId       String?
  provider    String
  model       String?
  promptTokens Int     @default(0)
  completionTokens Int @default(0)
  totalTokens Int      @default(0)
  costUsd     Float    @default(0)
  promptHash  String?
  outcome     String   @default("success")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
}

// ─── Consent / ToS / DPA acceptance ───────────────────

model Consent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy    String   // "tos" | "privacy" | "dpa" | "marketing"
  version   String
  acceptedAt DateTime @default(now())
  ipAddress String?

  @@index([userId, policy])
}

// ─── Billing & entitlements (Tier 10) ─────────────────

model Subscription {
  id                 String    @id @default(uuid())
  orgId              String    @unique
  planId             String    // matches plans.json tier id (free|starter|pro|enterprise|...)
  status             String    @default("trialing") // trialing|active|past_due|grace|suspended|canceled|none
  stripeCustomerId   String?
  stripeSubId        String?   @unique
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  canceledAt         DateTime?
  pastDueSince       DateTime?
  graceUntil         DateTime?
  suspendedAt        DateTime?
  metadata           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([trialEndsAt])
  @@index([graceUntil])
}

model UsageEvent {
  id        String   @id @default(uuid())
  orgId     String
  userId    String?
  meter     String   // records_per_month | api_calls_per_month | ai_tokens_per_month | ...
  quantity  Int
  period    String   // "YYYY-MM"
  metadata  String?
  createdAt DateTime @default(now())

  @@index([orgId, meter, period])
  @@index([period, createdAt])
}

model UsageCounter {
  id      String  @id @default(uuid())
  orgId   String
  meter   String
  period  String   // "YYYY-MM"
  value   BigInt   @default(0)

  @@unique([orgId, meter, period])
  @@index([orgId, period])
}

model Invoice {
  id              String   @id @default(uuid())
  stripeInvoiceId String   @unique
  orgId           String
  amountCents     Int
  currency        String   @default("usd")
  status          String   // paid|open|void|uncollectible
  periodStart     DateTime
  periodEnd       DateTime
  hostedUrl       String?
  createdAt       DateTime @default(now())

  @@index([orgId, createdAt])
}

model StripeEvent {
  id         String   @id        // Stripe event id, idempotency key
  type       String
  receivedAt DateTime @default(now())

  @@index([type, receivedAt])
}

// ─── Multi-tenant economics (Tier 12) ─────────────────

model TenantCostEvent {
  id        String   @id @default(uuid())
  orgId     String
  resource  String   // http_compute_ms | db_query_ms | storage_bytes | ai_tokens | egress_bytes
  quantity  Int      // resource units consumed (rounded)
  ucents    Int      // attributed cost in micro-cents (1/1000 of a cent)
  period    String   // "YYYY-MM"
  metadata  String?
  createdAt DateTime @default(now())

  @@index([orgId, period])
  @@index([orgId, resource, period])
  @@index([period, createdAt])
}

// ─── AI economics (Tier 13) ───────────────────────────

model AiSpendEvent {
  id               String   @id @default(uuid())
  orgId            String
  userId           String?
  provider         String?
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  ucents           Int      @default(0)   // micro-cents (1/1000 cent)
  period           String   // "YYYY-MM"
  outcome          String   @default("success")
  createdAt        DateTime @default(now())

  @@index([orgId, period])
  @@index([orgId, model, period])
  @@index([period, createdAt])
}

model EvalRun {
  id           String   @id @default(uuid())
  suite        String
  model        String
  provider     String?
  score        Float
  passed       Int
  total        Int
  durationMs   Int
  ucents       Int      @default(0)
  totalTokens  Int      @default(0)
  recordId     String?
  userId       String?
  createdAt    DateTime @default(now())
  results      EvalResult[]

  @@index([suite, createdAt])
  @@index([model, createdAt])
  @@index([recordId, createdAt])
}

model EvalResult {
  id              String   @id @default(uuid())
  runId           String
  run             EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId          String
  passed          Boolean
  durationMs      Int      @default(0)
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  ucents          Int      @default(0)
  failures        String?
  output          String?
  createdAt       DateTime @default(now())

  @@index([runId, passed])
}

// ─── Durable agent / workflow / goal runs ─────────────
model AgentRun {
  id        String   @id @default(uuid())
  orgId     String?
  userId    String?
  kind      String   // 'agent' | 'workflow' | 'goal'
  name      String
  status    String   // running | completed | failed | awaiting_approval | truncated
  input     String?
  output    String?
  steps     String?  // JSON: per-step trace
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, kind, createdAt])
  @@index([kind, status])
}

// ─── Durable behavior-flow sessions (guided intake / portal) ──
// A completed FSM conversation, persisted so leads survive restarts and the
// owner console / audit view can list and replay them. `slots` is the captured
// lead data; `trace` the full decision path.
model BehaviorSession {
  id          String   @id
  orgId       String?
  packId      String
  source      String   @default("authed") // authed | public
  outcome     String?
  guardsFired String?  // JSON array
  slots       String?  // JSON: captured fields (the lead)
  trace       String?  // JSON: full decision trace
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([packId, outcome])
}

// ─── Growth (Tier 14) ─────────────────────────────

model GrowthEvent {
  id         String   @id @default(uuid())
  name       String   // canonical event name e.g. signup.completed
  userId     String?
  orgId      String?
  source     String   @default("server") // server | client | system | webhook
  properties String?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([orgId, createdAt])
}

model OnboardingState {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedSteps String   @default("[]")  // JSON array of step ids
  completedAt    DateTime?
  updatedAt      DateTime @default(now()) @updatedAt
}

model LifecycleSent {
  id         String   @id @default(uuid())
  userId     String
  kind       String
  properties String?
  sentAt     DateTime @default(now())

  @@unique([userId, kind])
  @@index([kind, sentAt])
}

model FeatureFlag {
  key            String   @id
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(0)
  planAllowList  String?
  orgAllowList   String?
  orgDenyList    String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

// ─── Data products (Tier 15) ────────────────────────────
model DataExport {
  id           String    @id @default(uuid())
  runId        String    @unique
  status       String    @default("running") // running | success | partial | failed
  requestedBy  String?
  sinceMs      Int?
  manifest     String?
  sizeBytes    Int       @default(0)
  rowCount     Int       @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([status, startedAt])
}

// ─── Marketplace (Tier 16) ──────────────────────────────
model OAuthApp {
  id               String   @id @default(uuid())
  clientId         String   @unique
  clientSecretHash String
  name             String
  description      String?
  redirectUris     String   // newline-separated
  scopes           String   @default("read")
  orgId            String?
  ownerUserId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([orgId])
}

model OAuthGrant {
  id                  String    @id @default(uuid())
  grantType           String    // code | access | refresh
  tokenHash           String
  clientId            String
  userId              String
  scopes              String    @default("read")
  redirectUri         String?
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt           DateTime?
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([tokenHash])
  @@index([clientId, grantType])
  @@index([expiresAt])
}

model IntegrationInstallation {
  id            String   @id @default(uuid())
  orgId         String
  integrationId String
  status        String   @default("active")
  installedBy   String?
  config        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([orgId, integrationId])
  @@index([orgId])
}

// ─── Operations (Tier 17) ──────────────────────────────
model RequestSample {
  id         String   @id @default(uuid())
  kind       String   // http | job
  bucketAt   DateTime
  count      Int      @default(0)
  errorCount Int      @default(0)
  p95Ms      Int      @default(0)
  maxMs      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([kind, bucketAt])
  @@index([bucketAt])
}

model Incident {
  id         String    @id @default(uuid())
  title      String
  status     String    @default("open")    // open|investigating|identified|monitoring|resolved
  severity   String    @default("sev3")    // sev1..sev4
  component  String?
  publish    Boolean   @default(true)
  openedBy   String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  updates    IncidentUpdate[]

  @@index([status, createdAt])
  @@index([publish, createdAt])
}

model IncidentUpdate {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  status     String
  message    String
  authorId   String?
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

// ---- Tier 18: Trust-to-revenue ----

model ProspectKit {
  id              String    @id @default(uuid())
  prospectName    String?
  prospectCompany String?
  prospectEmail   String
  message         String?
  status          String    @default("requested") // requested | approved | rejected
  tokenHash       String?
  expiresAt       DateTime?
  maxDownloads    Int?
  downloadCount   Int       @default(0)
  lastDownloadedAt DateTime?
  requestedBy     String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([prospectEmail])
  @@index([tokenHash])
}

model QuestionnaireOverride {
  id         String   @id @default(uuid())
  orgId      String
  questionId String
  answer     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([orgId, questionId])
  @@index([orgId])
}

// ---- Tier 19: Governance ----

model ModelRegistration {
  id              String    @id @default(uuid())
  name            String
  provider        String
  modelId         String
  version         String?
  purpose         String?
  riskTier        String    @default("limited")
  status          String    @default("draft")
  dataInputs      String    @default("[]")
  dataOutputs     String    @default("[]")
  ownerId         String?
  registeredBy    String?
  statusUpdatedAt DateTime?
  statusUpdatedBy String?
  statusComment   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  evaluations ModelEvaluation[]

  @@index([status, createdAt])
  @@index([riskTier, status])
  @@index([provider, modelId])
}

model ModelEvaluation {
  id      String   @id @default(uuid())
  modelId String
  model   ModelRegistration @relation(fields: [modelId], references: [id], onDelete: Cascade)
  suite   String
  metric  String
  score   Float
  passed  Boolean  @default(false)
  notes   String?
  runBy   String?
  runAt   DateTime @default(now())

  @@index([modelId, runAt])
  @@index([suite, metric])
}

model Policy {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  summary        String?
  currentVersion String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  versions PolicyVersion[]
}

model PolicyVersion {
  id          String   @id @default(uuid())
  policyId    String
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version     String
  body        String
  bodyHash    String
  requiresAck Boolean  @default(true)
  publishedBy String?
  publishedAt DateTime @default(now())

  @@unique([policyId, version])
  @@index([policyId, publishedAt])
}

model PolicyAcknowledgement {
  id             String   @id @default(uuid())
  userId         String
  slug           String
  version        String
  acknowledgedAt DateTime @default(now())

  @@unique([userId, slug, version])
  @@index([slug, version])
  @@index([userId])
}

model BoardReport {
  id          String   @id
  period      String
  generatedAt DateTime @default(now())
  requestedBy String?
  path        String
  summary     String?

  @@index([period, generatedAt])
  @@index([generatedAt])
}

// ─── Vertical-OS Operations Hub (scheduling / invoicing / messaging) ─────────
// Durable store for the vertical-os ops hub (server/lib/ops-hub.js). Present in
// the base schema (superset) but only queried when the ops routes are mounted
// (has_vertical_os). Tenant-scoped by orgId.

model OpsAppointment {
  id          String    @id @default(uuid())
  orgId       String    @default("default")
  customer    String
  service     String
  startsAt    String
  durationMin Int       @default(30)
  notes       String    @default("")
  status      String    @default("booked")
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@index([orgId, createdAt])
  @@index([orgId, status])
}

model OpsInvoice {
  id         String    @id @default(uuid())
  orgId      String    @default("default")
  customer   String
  currency   String    @default("usd")
  amountCents Int      @default(0)
  items      String    @default("[]")
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([orgId, createdAt])
  @@index([orgId, status])
}

model OpsMessage {
  id        String   @id @default(uuid())
  orgId     String   @default("default")
  to        String
  channel   String   @default("email")
  subject   String   @default("")
  body      String
  status    String   @default("queued")
  error     String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

// ─── Spec-driven domain models (Phase 2 / Phase 1 hardening) ──
// orgId is REQUIRED on every tenant-owned row below (was optional — the
// #1 P0 tenant-isolation gap). It stays a plain scoped column (matching the
// existing Activity/AiUsage/TenantCostEvent convention) rather than a formal
// `org Organization @relation` on each — that would force 20+ rarely-used
// back-relation arrays onto Organization for no real integrity gain, since
// RLS (prisma/rls.sql) and tenant.js already enforce the boundary off this
// column. Actor-reference fields (uploaded_by_id, reviewer_id, approved_by_id,
// project_manager_id, estimator_id, etc.) stay plain User.id strings for the
// same reason. The document/finding/event/packet/outcome/customer graph
// itself — the thing the audit specifically flagged as "unvalidated string
// IDs" — uses real foreign keys with back-relations below.

model Customer {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  companyName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects     ProjectRecord[]
  rateSheets   RateSheet[]
  feedback     Feedback[]
  testimonials Testimonial[]

  @@index([orgId, createdAt])
  @@index([orgId, name])
}

model OrganizationRecord {
  id               String   @id @default(uuid())
  orgId            String   @unique
  name             String
  legal_name       String
  trade_types      String?
  timezone         String?
  currency         String?
  address          String?
  phone            String?
  website          String?
  billing_plan     String?
  default_markup   Float?
  default_tax_rate Float?
  default_retention_policy String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orgId])
}

model ProjectRecord {
  id               String   @id @default(uuid())
  orgId            String
  customer_id      String
  customer         Customer @relation(fields: [customer_id], references: [id])
  name             String
  project_number   String?
  trade            String?
  status           String   @default("active") // active|on_hold|completed|cancelled
  address          String?
  start_date       DateTime?
  expected_completion_date DateTime?
  contract_value   Float?
  original_estimate_value Float?
  project_manager_id String?
  estimator_id     String?
  original_scope_summary String?
  exclusions_summary String?
  audit_tier       String?
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceDocuments    SourceDocument[]
  changeEvents       ChangeEvent[]
  evidenceFindings   EvidenceFinding[]
  evidencePackets    EvidencePacket[]
  commercialOutcomes CommercialOutcome[]
  scopeItems         ScopeItem[]
  contractProvisions ContractProvision[]
  costItems          CostItem[]
  evidenceItems      EvidenceItem[]
  agentRuns          AgentRunRecord[]

  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([customer_id])
}

model SourceDocument {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String
  project          ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  document_type    String   // contract|estimate|change_order|invoice|photo|audio|email|message|other
  original_filename String
  storage_uri      String
  mime_type        String?
  file_size_bytes  Int?
  sha256_hash      String @unique
  uploaded_by_id   String?
  uploaded_at      DateTime
  extraction_status String?  // pending|processing|extracted|failed
  page_count       Int?
  document_date    DateTime?
  superseded       Boolean?
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contractProvisions ContractProvision[]
  evidenceItems      EvidenceItem[]
  citations          Citation[]
  scopeItems         ScopeItem[]

  @@index([orgId, createdAt])
  @@index([project_id])
}

model ChangeEvent {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String
  project          ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  title            String
  description      String?
  event_date       DateTime?
  status           String   // detected|reviewing|supported|unsupported|rejected|submitted
  reason_category  String?
  ai_confidence    Float?
  risk_level       String?
  missing_evidence String?
  contradictions   String?
  reviewer_notes   String?
  customer_validated_at DateTime?
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  evidenceFindings   EvidenceFinding[]
  scopeItems         ScopeItem[]
  costItems          CostItem[]
  commercialOutcomes CommercialOutcome[]

  @@index([orgId, createdAt])
  @@index([project_id, status])
}

model EvidenceFinding {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String
  project          ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  change_event_id  String?
  changeEvent      ChangeEvent? @relation(fields: [change_event_id], references: [id])
  finding_type     String   // scope_delta|contradiction|missing_evidence|duplicate|unsupported
  assertion        String
  source_citations String   // legacy denormalized JSON cache; Citation rows below are authoritative
  contradictory_evidence String?
  confidence       Float?
  severity         String?  // low|medium|high
  ai_generated     Boolean?
  human_decision   String?  // supported|unsupported|rejected|pending
  reviewer_id      String?
  decision_reason  String?
  userId           String?  // null for AI-generated findings (ai_generated=true) — no human creator until reviewed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  citations Citation[]

  @@index([orgId, createdAt])
  @@index([project_id, human_decision])
}

// Real citation grounding: one row per source span backing a finding, so
// citation validity can be checked against the actual document/evidence
// instead of trusting a free-text `source_citations` blob.
model Citation {
  id               String   @id @default(uuid())
  orgId            String
  findingId        String
  finding          EvidenceFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  evidenceItemId   String?
  evidenceItem     EvidenceItem? @relation(fields: [evidenceItemId], references: [id])
  pageNumber       Int?
  spanStart        Int?
  spanEnd          Int?
  quotedText       String?
  createdAt        DateTime @default(now())

  @@index([orgId, findingId])
  @@index([sourceDocumentId])
}

model EvidencePacket {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String
  project          ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  packet_number    String
  version          Int
  status           String   @default("draft") // draft|pending_approval|approved|exported|submitted
  recipient        String?
  executive_summary String?
  total_potential_amount Float?
  customer_validated_amount Float?
  pdf_storage_uri  String?
  content_hash     String?
  approved_by_id   String?
  approved_at      DateTime?
  exported_at      DateTime?
  submission_date  DateTime?
  submission_method String?
  external_reference String?
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  commercialOutcomes CommercialOutcome[]

  @@unique([project_id, packet_number, version])
  @@index([orgId, createdAt])
  @@index([project_id, status])
}

model CommercialOutcome {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String
  project          ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  change_event_id  String?
  changeEvent      ChangeEvent? @relation(fields: [change_event_id], references: [id])
  packet_id        String?
  packet           EvidencePacket? @relation(fields: [packet_id], references: [id])
  identified_amount Float?
  validated_amount Float?
  submitted_amount Float?
  approved_amount  Float?
  invoiced_amount  Float?
  collected_amount Float?
  invoice_number   String?
  invoice_date     DateTime?
  payment_date     DateTime?
  notes            String?
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  outcomeEvidence  OutcomeEvidence[]
  stageTransitions StageTransition[]

  @@index([orgId, createdAt])
  @@index([project_id])
}

// Immutable ledger of the six financial stages (identified -> validated ->
// submitted -> approved -> invoiced -> collected). CommercialOutcome's six
// *_amount columns stay as a denormalized "current state" read model; every
// transition that changes one is also appended here so the history can never
// be silently overwritten or a stage skipped/mislabeled without a trace.
model StageTransition {
  id        String   @id @default(uuid())
  orgId     String
  outcomeId String
  outcome   CommercialOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  fromStage String?  // null on the first transition
  toStage   String   // identified|validated|submitted|approved|invoiced|collected
  amount    Float
  actorId   String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([orgId, outcomeId, createdAt])
}

model OutcomeEvidence {
  id           String   @id @default(uuid())
  orgId        String
  outcomeId    String
  outcome      CommercialOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  evidenceType String   // invoice|payment_confirmation|remittance|bank_statement|email_confirmation
  storageUri   String?
  amount       Float?
  documentDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([orgId, outcomeId])
}

model AgentRunRecord {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String?
  project          ProjectRecord? @relation(fields: [project_id], references: [id])
  agent_type       String
  status           String   // running|completed|failed|awaiting_approval
  model_name       String?
  model_version    String?
  input_refs       String?
  output_refs      String?
  source_citations String?
  confidence       Float?
  token_usage      Int?
  estimated_cost_usd Float?
  latency_ms       Int?
  error_message    String?
  human_decision   String?
  completed_at     DateTime?
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orgId, createdAt])
  @@index([project_id])
}

model ScopeItem {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String
  project          ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  source           String   @default("original") // original|revised|change_event
  change_event_id  String?
  changeEvent      ChangeEvent? @relation(fields: [change_event_id], references: [id])
  description      String
  quantity         Float?
  unit             String?
  unitRate         Float?
  totalAmount      Float?
  category         String?
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  pageReference    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  costItems CostItem[]

  @@index([orgId, project_id])
  @@index([project_id, source])
}

model ContractProvision {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String
  project          ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sourceDocumentId String
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  category         String?  // scope|pricing|schedule|change_order|exclusion|payment_terms
  clauseText       String
  pageNumber       Int?
  sectionRef       String?
  extractedByRunId String?
  confidence       Float?
  createdAt        DateTime @default(now())

  @@index([orgId, project_id])
  @@index([sourceDocumentId])
}

model CostItem {
  id              String   @id @default(uuid())
  orgId           String
  project_id      String
  project         ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  change_event_id String?
  changeEvent     ChangeEvent? @relation(fields: [change_event_id], references: [id])
  scopeItemId     String?
  scopeItem       ScopeItem? @relation(fields: [scopeItemId], references: [id])
  category        String   // labor|material|equipment|subcontractor|markup|tax
  description     String
  quantity        Float?
  unit            String?
  unitCost        Float?
  totalCost       Float?
  rateSheetItemId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId, project_id])
}

model RateSheet {
  id            String   @id @default(uuid())
  orgId         String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  name          String
  trade         String?
  effectiveDate DateTime?
  version       Int      @default(1)
  status        String   @default("active") // draft|active|superseded
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items RateSheetItem[]

  @@index([orgId, status])
  @@index([customerId])
}

model RateSheetItem {
  id          String   @id @default(uuid())
  orgId       String
  rateSheetId String
  rateSheet   RateSheet @relation(fields: [rateSheetId], references: [id], onDelete: Cascade)
  code        String?
  description String
  unit        String?
  unitRate    Float
  category    String?
  createdAt   DateTime @default(now())

  @@index([orgId, rateSheetId])
}

model EvidenceItem {
  id               String   @id @default(uuid())
  orgId            String
  project_id       String
  project          ProjectRecord @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id])
  evidenceType     String   // photo|audio|receipt|message|video|document
  storageUri       String
  sha256Hash       String
  mimeType         String?  // real sniffed content-type (e.g. image/heic) — set at upload; older rows may be null
  capturedAt       DateTime?
  gpsLat           Float?
  gpsLng           Float?
  deviceMetadata   String?  // JSON: EXIF / device model / app version
  transcript       String?  // audio transcription text
  extractedText    String?  // OCR / extracted text
  uploadedById     String?
  duplicateOfId    String?
  quality          String?  // ok|low_quality|unreadable
  analysisStatus   String?  // null=never analyzed|queued|processing|completed|failed — Cloud Tasks idempotency gate
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  citations Citation[]

  // NOT unique, deliberately: a field worker genuinely re-photographing the
  // same thing twice must still be able to upload both — routes/evidence.js
  // detects the repeated hash and records the relationship via duplicateOfId
  // instead of rejecting the second upload outright.
  @@index([orgId, sha256Hash])
  @@index([orgId, project_id])
  @@index([project_id, evidenceType])
}

model ConsentRecord {
  id          String   @id @default(uuid())
  orgId       String
  project_id  String?
  subjectType String   // employee|customer|third_party
  subjectName String?
  consentType String   // photo|audio|video|testimonial|location|biometric
  granted     Boolean  @default(true)
  grantedById String?
  method      String?  // verbal_logged|written|digital_signature
  evidenceUri String?
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([orgId, project_id])
  @@index([orgId, consentType])
}

model Feedback {
  id              String   @id @default(uuid())
  orgId           String
  project_id      String?
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  rating          Int?
  comment         String?
  consentToShare  Boolean  @default(false)
  consentRecordId String?
  createdAt       DateTime @default(now())

  testimonials Testimonial[]

  @@index([orgId, createdAt])
  @@index([customerId])
}

model Testimonial {
  id              String   @id @default(uuid())
  orgId           String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  feedbackId      String?
  feedback        Feedback? @relation(fields: [feedbackId], references: [id])
  quote           String
  authorName      String?
  authorTitle     String?
  consentRecordId String?
  status          String   @default("pending") // pending|approved|rejected
  featured        Boolean  @default(false)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([orgId, status])
}

model RetentionLegalHold {
  id           String   @id @default(uuid())
  orgId        String
  resourceType String   // project|sourceDocument|evidenceItem|evidencePacket
  resourceId   String
  holdType     String   // legal_hold|retention_policy
  reason       String?
  policyDays   Int?
  placedById   String?
  placedAt     DateTime @default(now())
  releasedById String?
  releasedAt   DateTime?

  @@index([orgId, resourceType, resourceId])
  @@index([orgId, releasedAt])
}

// Competition Evidence Center: append-only ledger of arms-length-classified
// facts (revenue, customers, expenses, testimonials, deployment/uptime proof)
// used to build judge-facing reports without ever touching demo/test data.
model CompetitionEvidence {
  id                String   @id @default(uuid())
  orgId             String
  category          String   // revenue|customer|expense|testimonial|deployment|uptime
  classification    String?  // arms_length|related_party (revenue rows)
  period            String?  // "YYYY-MM"
  label             String
  amountCents       Int?
  quantity          Int?
  sourceType        String?  // stripe|gcp_billing|agent_run|manual
  sourceRef         String?
  isDemoData        Boolean  @default(false)
  excludeFromReport Boolean  @default(false)
  notes             String?
  recordedById      String?
  createdAt         DateTime @default(now())

  @@index([orgId, category, period])
  @@index([orgId, isDemoData])
}

// ─── Organization membership & invitations ────────────
// Replaces "one orgId directly on the user" as the source of truth for
// who belongs to an org and with what role. User.orgId is kept as a cached
// "current/active org" pointer (set at signup, updated on invite-accept);
// OrgMembership is authoritative for multi-member access control.
model OrgMembership {
  id        String   @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("viewer")
  status    String   @default("active") // active|suspended|removed
  invitedBy String?
  joinedAt  DateTime @default(now())
  removedAt DateTime?

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, status])
}

model Invitation {
  id         String   @id @default(uuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email      String
  role       String
  tokenHash  String   @unique
  invitedBy  String?
  status     String   @default("pending") // pending|accepted|revoked|expired
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([orgId, status])
  @@index([email])
}



